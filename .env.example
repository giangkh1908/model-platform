# Chép file này thành .env (cùng thư mục) rồi điền giá trị. .env chứa bí mật: không commit, không gửi cho ai.
# Biến đã đặt trong Windows (setx) được ưu tiên hơn giá trị ở đây. Sửa xong thì khởi động lại nền tảng.

# Hugging Face (model gated như Llama, Gemma): huggingface.co/settings/tokens, loại Read
HF_TOKEN=

# Model registry: MLflow server chạy bằng `docker compose up -d` (xem docker-compose.yml)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Cloudflare R2 (tuỳ chọn, hiện file model lưu trên máy ở data/mlflow/artifacts). Muốn dùng thì xem docker-compose.yml.
# dash.cloudflare.com -> R2 -> Manage API tokens (Object Read & Write). Chỉ MLflow server dùng các biến này.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=model-registry
